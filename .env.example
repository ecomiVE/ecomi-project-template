# -----------------------------------------------------------------------------
# <Project name> — environment variables
#
# This file is the source of truth for variable NAMES.
# The password manager is the source of truth for VALUES.
#
# Setup:   cp .env.example .env   then fill in the values.
# Rules:   - add a new variable HERE in the same PR that introduces it
#          - set it in Dokploy (staging + production) BEFORE merging that PR
#          - names are identical across local / staging / production
#          - never commit .env; never paste values into chat or email
#
# Leave placeholder values as they are. Do not put real values in this file.
# -----------------------------------------------------------------------------


# --- Application -------------------------------------------------------------

# local | staging | production
APP_ENV=local

# Enables verbose errors and reload. Never true in production.
APP_DEBUG=true

# Port the application listens on locally.
APP_PORT=8000

# Public base URL. Used for callbacks, links in emails, CORS.
APP_URL=http://localhost:8000

# Random string, unique per environment. Rotating it invalidates sessions.
APP_SECRET=change-me


# --- Database ----------------------------------------------------------------

DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Optional: connection pool size. Raise only with a reason.
# DATABASE_POOL_SIZE=5


# --- Cache / queue -----------------------------------------------------------
# Delete this block if the project has neither.

# REDIS_URL=redis://localhost:6379/0


# --- Object storage ----------------------------------------------------------
# Delete this block if the project stores no files.

# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=


# --- AI / model providers ----------------------------------------------------
# Delete this block if the project uses no models.
# Cost scales with usage — see the project cost estimate before raising limits.

# Pin the model explicitly. "latest" makes behaviour and cost change silently.
# LLM_PROVIDER=
# LLM_MODEL=
# LLM_API_KEY=

# Guardrails. Keep these set even in development.
# LLM_MAX_OUTPUT_TOKENS=1024
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2


# --- Third-party APIs --------------------------------------------------------
# One block per service. Say what it is for, so the next person knows whether
# they can remove it.

# <SERVICE>_API_KEY=
# <SERVICE>_BASE_URL=


# --- Email / notifications ---------------------------------------------------
# Delete this block if the project sends nothing.

# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=


# --- Observability -----------------------------------------------------------

# Error tracking DSN. Empty locally is fine.
# SENTRY_DSN=

# debug | info | warning | error
LOG_LEVEL=info
